{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node site/build.mjs",
  "outputDirectory": "site/dist",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != production ] || git diff --quiet HEAD^ HEAD -- site api lib src/ui/static assets README.md docs CHANGELOG.md AGENTS.md bench blog tests/fixtures/agents/malicious package.json package-lock.json vercel.json server.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source": "/upkeep", "destination": "/pro", "permanent": true},
    {"source": "/upkeep.md", "destination": "/pro.md", "permanent": true},
    {"source": "/research/e20", "destination": "/research-e20", "permanent": true}
  ],
  "rewrites": [
    {"source": "/api", "destination": "/api/no-route"},
    {"source": "/api/(.*)", "destination": "/api/no-route"},
    {"source": "/(.*)", "has": [{"type": "header", "key": "accept", "value": "(.*)text/markdown(.*)"}], "destination": "/api/not-found"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src https://penthera.org/_vercel/insights/ https://penthera.org/_vercel/speed-insights/ https://www.penthera.org/_vercel/insights/ https://www.penthera.org/_vercel/speed-insights/ https://penthera.org/api/check https://www.penthera.org/api/check; manifest-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\"" }
      ]
    },
    {
      "source": "/(openapi|server)\\.json",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt|robots\\.txt|\\.well-known/security\\.txt)",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/(media|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(check.js|styles.css|theme.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {"api/check.mjs": {"includeFiles": "{lib/rules/**,lib/data/**}", "maxDuration": 60}}
}
