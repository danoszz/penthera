{
  "name": "penthera",
  "version": "1.9.0",
  "type": "module",
  "description": "Offline cyber security agent for your apps and AI coding tools. Open R&D: measured in public, improved every release.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danoszz/penthera.git"
  },
  "homepage": "https://penthera.org",
  "mcpName": "io.github.danoszz/penthera",
  "bugs": {
    "url": "https://github.com/danoszz/penthera/issues"
  },
  "bin": {
    "penthera": "bin/penthera.js",
    "penthera-scan": "bin/scan.js"
  },
  "files": [
    "bin",
    "src",
    "lib",
    "skills",
    "docs/examples",
    "scripts/rules",
    "pentest.config.example.js",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    "./plugins": "./lib/plugins.js",
    "./adaptive": "./lib/blackbox/adaptive-scan.js",
    "./wstg": "./lib/owasp-wstg.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:load": "node scripts/test-under-load.mjs",
    "lint": "eslint .",
    "scan": "node bin/penthera.js",
    "scan:full": "node bin/scan.js",
    "pentest": "vitest run --reporter=verbose",
    "pentest:watch": "vitest --reporter=verbose",
    "pentest:live": "vitest run tests/pentest-live.test.js --reporter=verbose",
    "pentest:adaptive": "vitest run tests/pentest-adaptive.test.js --reporter=verbose",
    "pentest:recon": "vitest run tests/pentest-recon.test.js --reporter=verbose",
    "pentest:mock": "vitest run tests/pentest-mock.test.js --reporter=verbose",
    "pentest:wstg": "vitest run tests/owasp-wstg.test.js --reporter=verbose",
    "validate:report": "node skills/penthera/scripts/validate-report.mjs",
    "package:skill": "bash scripts/package-skill.sh",
    "refresh:popular": "node scripts/refresh-popular-packages.mjs",
    "refresh:popular-pypi": "node scripts/refresh-popular-pypi.mjs",
    "mock-server": "node tests/fixtures/mock-server.js",
    "bench": "node bench/run.js",
    "bench:known": "node bench/known-vuln/run.mjs",
    "docs:numbers": "node scripts/docs-numbers.mjs",
    "changelog": "node scripts/changelog.mjs",
    "refresh:retire-db": "node scripts/refresh-retire-db.mjs",
    "rules:build": "node scripts/rules/build-pack.mjs",
    "rules:check": "node scripts/rules/check-bundled.mjs",
    "audit:internal": "node scripts/audit/run.mjs",
    "bench:public": "node bench/public/run.mjs"
  },
  "keywords": [
    "security",
    "scanner",
    "pentest",
    "vulnerability",
    "recon",
    "cli",
    "agent-skills",
    "cursor",
    "claude-code",
    "owasp",
    "sarif",
    "supply-chain",
    "dependencies",
    "mcp",
    "ai-security",
    "agent-security",
    "nis2",
    "sbom",
    "offline",
    "devsecops",
    "mcp-server",
    "model-context-protocol",
    "agent-skill",
    "security-scanner",
    "vibe-coding",
    "secrets",
    "website-security",
    "security-headers"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "^8.20.0",
    "eslint": "10.12.0",
    "fast-check": "^4.10.2",
    "globals": "17.12.0",
    "rolldown": "1.2.14",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
